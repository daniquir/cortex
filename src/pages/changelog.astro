---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Changelog — Cortex">
  <h1>Changelog</h1>

  <div class="entry">
    <h2>v0.3 <span class="date">Jul 2026</span></h2>
    <ul>
      <li>Plan → Build workflow (Cursor-like)</li>
      <li>Saved plans with checklists</li>
      <li>Multi-provider auth via OpenCode</li>
      <li>Inline diff acceptance</li>
      <li>Semantic + lexical context search</li>
    </ul>
  </div>

  <div class="entry">
    <h2>v0.2 <span class="date">Jun 2026</span></h2>
    <ul>
      <li>Chat sidebar with streaming</li>
      <li>Tool usage timeline</li>
      <li>Context blocks (@mentions)</li>
    </ul>
  </div>

  <div class="entry">
    <h2>v0.1 <span class="date">May 2026</span></h2>
    <ul>
      <li>Initial release</li>
      <li>Basic chat with OpenCode</li>
      <li>Multi-provider support</li>
    </ul>
  </div>
</Layout>

<style>
  h1 { margin-top: 3rem; }
  .entry {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .entry h2 {
    font-size: 1.3rem;
    margin-bottom: 0.75rem;
  }
  .date {
    color: var(--text-muted);
    font-weight: 400;
    font-size: 0.9rem;
  }
  ul {
    margin-left: 1.5rem;
    color: var(--text-muted);
  }
  li { margin-bottom: 0.4rem; }
</style>
