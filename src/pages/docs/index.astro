---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Docs — Cortex">
  <h1>Documentation</h1>
  <p style="color: var(--text-muted); margin-bottom: 2rem;">
    Everything you need to get started with Cortex.
  </p>

  <div class="doc-grid">
    <a class="doc-card" href={`${import.meta.env.BASE_URL}docs/install/`}>
      <h3>Installation</h3>
      <p>How to install and set up Cortex in VS Code.</p>
    </a>
    <a class="doc-card" href={`${import.meta.env.BASE_URL}docs/config/`}>
      <h3>Configuration</h3>
      <p>Settings, providers, and customization options.</p>
    </a>
    <a class="doc-card" href={`${import.meta.env.BASE_URL}docs/architecture/`}>
      <h3>Architecture</h3>
      <p>How Cortex works under the hood.</p>
    </a>
  </div>
</Layout>

<style>
  h1 { margin-top: 3rem; }
  .doc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .doc-card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    color: var(--text);
    transition: border-color 0.15s;
  }
  .doc-card:hover { border-color: var(--accent); }
  .doc-card h3 { margin-bottom: 0.5rem; }
  .doc-card p { color: var(--text-muted); font-size: 0.9rem; margin: 0; }
</style>
