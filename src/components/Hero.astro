---
import fs from 'node:fs';
import path from 'node:path';
import { getT, type Lang, defaultLang } from '../i18n/translations';
import { getBase, langHref } from '../i18n/paths';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = getT(lang);
const base = getBase();

const publicDir = path.join(process.cwd(), 'public');
const hasMp4 = fs.existsSync(path.join(publicDir, 'demo.mp4'));
const hasGif = fs.existsSync(path.join(publicDir, 'demo.gif'));
const hasPoster = fs.existsSync(path.join(publicDir, 'demo-poster.webp'));
const demoKind: 'mp4' | 'gif' | 'placeholder' = hasMp4 ? 'mp4' : hasGif ? 'gif' : 'placeholder';
---
<section class="hero">
  <div class="badge">{t.badge}</div>
  <h1>Cortex</h1>
  <p class="tagline">{t.tagline}</p>
  <div class="actions">
    <a class="btn primary" href="https://marketplace.visualstudio.com/items?itemName=cortex-labs.cortex-agent" target="_blank" rel="noopener">
      {t.ctaInstall}
    </a>
    <a class="btn" href="https://open-vsx.org/extension/cortex-labs/cortex-agent" target="_blank" rel="noopener">
      {t.ctaOpenVsx}
    </a>
    <a class="btn" href={langHref(lang, 'docs/')}>
      {t.ctaDocs}
    </a>
  </div>
  <p class="sub">{t.sub}</p>

  <div class="demo">
    {demoKind === 'mp4' ? (
      <video
        class="demo-media"
        autoplay
        muted
        loop
        playsinline
        poster={hasPoster ? `${base}demo-poster.webp` : undefined}
        aria-label={t.heroDemoAlt}
      >
        <source src={`${base}demo.mp4`} type="video/mp4" />
      </video>
    ) : demoKind === 'gif' ? (
      <img class="demo-media" src={`${base}demo.gif`} alt={t.heroDemoAlt} width="1280" height="720" />
    ) : (
      <div class="demo-placeholder" role="img" aria-label={t.heroDemoAlt}>
        <span class="demo-placeholder-label">{t.heroDemoPlaceholder}</span>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    text-align: center;
    padding: 5rem 0 3.5rem;
  }
  .badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--accent);
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }
  .hero h1 {
    font-size: 4rem;
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #39ff14, #a8ff00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 20px #39ff1433);
  }
  .tagline {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 620px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  .btn {
    display: inline-block;
    padding: 0.8rem 1.75rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid var(--border);
    color: var(--text);
    transition: all 0.2s;
  }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn.primary {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
    font-weight: 700;
  }
  .btn.primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    box-shadow: 0 0 20px #39ff1444;
  }
  .sub {
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 500px;
    margin: 0 auto 2.5rem;
  }
  .demo {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
  }
  .demo-media {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .demo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    border: 1px dashed var(--accent);
    background:
      linear-gradient(135deg, var(--accent-dim), transparent 55%),
      var(--surface);
  }
  .demo-placeholder-label {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0 1.5rem;
  }
  @media (max-width: 640px) {
    .hero h1 { font-size: 2.75rem; }
    .demo { margin-inline: -0.25rem; }
  }
</style>
