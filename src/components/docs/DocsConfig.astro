---
import Layout from '../../layouts/Layout.astro';
import { getDocs } from '../../i18n/docs';
import type { Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = getDocs(lang);
---
<Layout title={d.configMetaTitle} lang={lang}>
  <h1>{d.configTitle}</h1>

  <h2>{d.configSettings}</h2>
  <p>{d.configSettingsIntro}</p>

  <table>
    <thead>
      <tr>
        {d.configTableHeaders.map((h) => <th>{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {d.configRows.map((row) => (
        <tr>
          <td><code>{row.setting}</code></td>
          <td><code>{row.default}</code></td>
          <td>{row.desc}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>{d.configShortcuts}</h2>
  <p>{d.configShortcutsIntro}</p>
  <table>
    <thead>
      <tr>
        {d.configShortcutHeaders.map((h) => <th>{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {d.configShortcutRows.map((row) => (
        <tr>
          <td><code>{row.keys}</code></td>
          <td>{row.action}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>{d.configCommands}</h2>
  <p>{d.configCommandsIntro}</p>
  <table>
    <thead>
      <tr>
        {d.configCommandHeaders.map((h) => <th>{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {d.configCommandRows.map((row) => (
        <tr>
          <td><code>{row.command}</code></td>
          <td>{row.desc}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>{d.configModels}</h2>
  <p>{d.configModelsIntro}</p>
  <ul>
    {d.configModelItems.map((item) => (
      <li><strong>{item.name}</strong> — {item.desc}</li>
    ))}
  </ul>
  <p class="note">{d.configOpenCodeNote}</p>

  <h2>{d.configContext}</h2>
  <p>{d.configContextIntro}</p>
  <ul>
    {d.configContextItems.map((item) => (
      <li><strong>{item.name}</strong> — {item.desc}</li>
    ))}
  </ul>
</Layout>

<style>
  h1 { margin-top: 3rem; }
  h2 { margin-top: 2rem; margin-bottom: 0.75rem; }
  p { color: var(--text-muted); margin-bottom: 1rem; }
  p.note { font-size: 0.9rem; margin-top: 0.5rem; }
  ul { margin-left: 1.5rem; margin-bottom: 1rem; color: var(--text-muted); }
  li { margin-bottom: 0.5rem; }
  code {
    background: var(--surface);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
  }
  th, td {
    text-align: left;
    padding: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  th { color: var(--text); font-size: 0.85rem; text-transform: uppercase; }
  td { color: var(--text-muted); font-size: 0.9rem; }
</style>
