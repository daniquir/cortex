---
import Layout from '../../layouts/Layout.astro';
import { getDocs } from '../../i18n/docs';
import type { Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = getDocs(lang);
---
<Layout title={d.installMetaTitle} lang={lang}>
  <h1>{d.installTitle}</h1>

  <aside class="docs-alert" role="note">
    <p class="docs-alert-label">{d.installAlertLabel}</p>
    <h2 class="docs-alert-title">{d.installAlertTitle}</h2>
    <p class="docs-alert-body">{d.installAlertBody}</p>
    <p class="docs-alert-link">
      <a href="https://opencode.ai" target="_blank" rel="noopener">{d.installAlertLinkLabel}</a>
    </p>
  </aside>

  <h2>{d.installFromMarketplace}</h2>
  <ol>
    {d.installMarketplaceSteps.map((step) => <li>{step}</li>)}
  </ol>
  <pre><code>{d.installMarketplaceCmd}</code></pre>

  <h2>{d.installFromOpenVsx}</h2>
  <p>
    {d.installOpenVsxIntro}
    {' '}
    <a href="https://open-vsx.org/extension/cortex-labs/cortex-agent" target="_blank" rel="noopener">open-vsx.org</a>
  </p>
  <pre><code>{d.installOpenVsxCmd}</code></pre>

  <h2>{d.installFromVsix}</h2>
  <p>{d.installVsixIntro}</p>
  <pre><code>{d.installVsixCmd}</code></pre>

  <h2>{d.installFirstRun}</h2>
  <ol>
    {d.installFirstRunSteps.map((step) => (
      <li>
        {step.before}
        {step.strong && <strong>{step.strong}</strong>}
        {step.after}
      </li>
    ))}
  </ol>

  <h2>{d.installRequirements}</h2>
  <ul>
    {d.installReqItems.map((item) => <li>{item}</li>)}
  </ul>
</Layout>

<style>
  h1 { margin-top: 3rem; }
  h2 { margin-top: 2rem; margin-bottom: 0.75rem; }
  p { color: var(--text-muted); margin-bottom: 1rem; }
  p a { color: var(--accent); }
  ol, ul { margin-left: 1.5rem; margin-bottom: 1rem; color: var(--text-muted); }
  li { margin-bottom: 0.5rem; }
  code {
    background: var(--surface);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9rem;
  }
  pre {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  pre code { background: none; padding: 0; }

  .docs-alert {
    margin: 1.5rem 0 2rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--border));
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
  }
  .docs-alert-label {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .docs-alert-title {
    margin: 0 0 0.6rem;
    font-size: 1.15rem;
    color: var(--text);
  }
  .docs-alert-body {
    margin: 0 0 0.75rem;
    color: var(--text);
    line-height: 1.5;
  }
  .docs-alert-link {
    margin: 0;
  }
  .docs-alert-link a {
    font-weight: 600;
    color: var(--accent);
  }
</style>
