---
import { getT, type Lang, defaultLang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = getT(lang);
---
<section class="compare">
  <h2>{t.compareTitle}</h2>
  <p class="subtitle">{t.compareSubtitle}</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th></th>
          <th class="highlight">Cortex</th>
          <th>Cursor</th>
          <th>Windsurf</th>
        </tr>
      </thead>
      <tbody>
        {t.compareRows.map((r) => (
          <tr>
            <td class="feature">{r.feature}</td>
            <td class="highlight">{r.cortex}</td>
            <td>{r.cursor}</td>
            <td>{r.windsurf}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    {t.compareNote}
  </p>
</section>

<style>
  .compare { padding: 4rem 0; }
  .compare h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }
  .subtitle {
    text-align: center;
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }
  .table-wrap {
    overflow-x: auto;
    margin-bottom: 2rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  th, td {
    padding: 0.85rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  th {
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  th.highlight, td.highlight {
    color: var(--accent);
    font-weight: 600;
  }
  th.highlight {
    position: relative;
  }
  th.highlight::after {
    content: '★';
    margin-left: 0.35rem;
    font-size: 0.7rem;
  }
  td.feature {
    color: var(--text);
    font-weight: 500;
    white-space: nowrap;
  }
  tr:hover td {
    background: var(--surface);
  }
  .note {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }
  .note a { font-weight: 600; }
</style>
