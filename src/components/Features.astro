---
const features = [
  {
    icon: '🤖',
    title: 'Multi-provider AI',
    desc: 'Connect OpenAI, Anthropic, Google, xAI, and more. Switch models on the fly.',
  },
  {
    icon: '🔍',
    title: 'Context-aware',
    desc: 'Lexical + semantic search over your codebase. The agent sees what matters.',
  },
  {
    icon: '📝',
    title: 'Plan & Build',
    desc: 'Analyze first, then implement. Two-mode workflow inspired by Cursor Agent.',
  },
  {
    icon: '🔧',
    title: 'Inline edits',
    desc: 'Accept/reject AI suggestions directly in the editor with diff preview.',
  },
  {
    icon: '💬',
    title: 'Chat sidebar',
    desc: 'Full conversation history, tool usage timeline, markdown streaming.',
  },
  {
    icon: '🔌',
    title: 'MCP support',
    desc: 'Connect external tools via Model Context Protocol servers.',
  },
];
---
<section class="features">
  <h2>Features</h2>
  <div class="grid">
    {features.map((f) => (
      <div class="card">
        <span class="icon">{f.icon}</span>
        <h3>{f.title}</h3>
        <p>{f.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .features { padding: 4rem 0; }
  .features h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 2.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .icon { font-size: 1.5rem; }
  .card h3 { margin: 0.5rem 0 0.25rem; font-size: 1.1rem; }
  .card p { color: var(--text-muted); font-size: 0.9rem; }
</style>
